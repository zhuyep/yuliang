# This working directory also contains private experiments. Track only the
# independent app. Keep this list aligned with scripts/check-repo.mjs.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/README.en.md
!/DOGFOOD.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/index.html
!/app.js
!/styles.css
!/favicon.svg
!/insights.html
!/insights.css
!/insights.js
!/lib/
/lib/*
!/lib/analysis.mjs
!/lib/api.mjs
!/lib/garmin-database.mjs
!/lib/feedback.mjs
!/lib/model.mjs
!/data/
/data/*
!/data/example-garmin-day.json
!/data/example-ready-day.json
!/scripts/
/scripts/*
!/scripts/serve.mjs
!/scripts/check-repo.mjs
!/tests/
/tests/*
!/tests/server.test.mjs
!/tests/insights.test.mjs
!/docs/
/docs/*
!/docs/ARCHITECTURE.md
!/docs/ROADMAP.md
!/docs/LOCAL_INSIGHTS.md
# Never override these exclusions to publish personal data or credentials.
**/.env
**/.env.*
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.pem
**/*.key
**/node_modules/
**/.DS_Store
